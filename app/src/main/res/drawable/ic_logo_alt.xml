<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ 白い熊 店 (shiroikuma-mise): the traced basket + triangle mark, same line-art as
  ~ ic_launcher_foreground but scaled to fill the viewport — this one is drawn as a
  ~ standalone logo (splash / deep-link sheet), not as an adaptive-icon foreground,
  ~ so it must not carry the launcher safe-zone margin. The yellow is always #FFFF00.
  ~ SPDX-License-Identifier: GPL-3.0-or-later
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- art is centred on (256,256) and ~301 wide; 1.6x fills the box with a small margin -->
    <group
        android:scaleX="1.6"
        android:scaleY="1.6"
        android:translateX="-153.6"
        android:translateY="-153.6">
        <!-- basket handle -->
        <path
            android:pathData="M190,208L244,122Q255,105 266,122L324,208"
            android:fillColor="#00000000"
            android:strokeColor="#FFFF00"
            android:strokeWidth="16"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- basket body -->
        <path
            android:pathData="M120,212L392,212Q400,212 398,230L370,378Q367,398 350,398L162,398Q145,398 142,378L114,230Q112,212 120,212Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFF00"
            android:strokeWidth="17"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- the triangle mark: three separate strokes, so all six ends are rounded tips -->
        <path
            android:pathData="M256,246L318,352"
            android:fillColor="#00000000"
            android:strokeColor="#FFFF00"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M194,352L256,246"
            android:fillColor="#00000000"
            android:strokeColor="#FFFF00"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M196,357L316,357"
            android:fillColor="#00000000"
            android:strokeColor="#FFFF00"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
