<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ 白い熊 店 (shiroikuma-mise): the notification small icon. Upstream points every notification
  ~ at this drawable and draws Aurora's own mark in it, so the name stays (no rebase conflict at
  ~ the call sites) and the content is ours: the paths of ic_launcher_monochrome verbatim, the
  ~ viewport cropped to the mark so it fills the 24dp canvas. The system tints it.
  ~ SPDX-License-Identifier: GPL-3.0-or-later
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="320"
    android:viewportHeight="320">
    <group
        android:translateX="-96"
        android:translateY="-92">
        <!-- basket handle -->
        <path
            android:pathData="M190,208L244,122Q255,105 266,122L324,208"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="16"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- basket body -->
        <path
            android:pathData="M120,212L392,212Q400,212 398,230L370,378Q367,398 350,398L162,398Q145,398 142,378L114,230Q112,212 120,212Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="17"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- the triangle mark: three separate strokes, so all six ends are rounded tips -->
        <path
            android:pathData="M256,246L318,352"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M194,352L256,246"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M196,357L316,357"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
