    <string name="mise_ui_automation_token_regenerate">再生成</string>
    <string name="mise_ui_automation_token_copied">トークンをコピーしました。</string>
    <string name="mise_ui_automation_token_regenerated">トークンを新しくしました。ほかの場所に貼り付けたものもすべて更新してください。</string>

